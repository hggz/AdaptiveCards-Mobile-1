<Window
    x:Class="AdaptiveCardsWpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Adaptive Cards · WPF host (via AdaptiveCardsCABIShared.dll)"
    Width="900"
    Height="780"
    Background="#1e1e1e"
    Foreground="#e0e0e0">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e0e0e0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2d2d30" />
            <Setter Property="Foreground" Value="#e0e0e0" />
            <Setter Property="BorderBrush" Value="#3f3f46" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2d2d30" />
            <Setter Property="Foreground" Value="#e0e0e0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="#e0e0e0" />
            <Setter Property="BorderBrush" Value="#3f3f46" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e0e0e0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2d2d30" />
            <Setter Property="Foreground" Value="#e0e0e0" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Adaptive Cards · WPF host (P/Invoke into AdaptiveCardsCABIShared.dll)"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center" />
            <ComboBox x:Name="SampleCombo" Width="220" SelectionChanged="SampleCombo_SelectionChanged" />
        </StackPanel>

        <TextBlock x:Name="BackendLabel"
                   DockPanel.Dock="Top"
                   Margin="0,0,0,6"
                   Opacity="0.7"
                   FontSize="11" />

        <Border DockPanel.Dock="Bottom"
                BorderBrush="#3f3f46"
                BorderThickness="1"
                Padding="6"
                Margin="0,8,0,0"
                Background="#252526">
            <StackPanel>
                <TextBlock Text="Action transcript" FontWeight="Bold" Margin="0,0,0,4" />
                <ScrollViewer Height="110" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TranscriptList" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="CardScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ContentPresenter x:Name="CardContainer" Margin="6" />
        </ScrollViewer>
    </DockPanel>
</Window>
