{
  "type": "AdaptiveCard",
  "version": "1.6",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "body": [
    {
      "type": "TextBlock",
      "text": "Windows Extras",
      "size": "Large",
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "Exercises Chart, TabSet, CompoundButton, and Carousel in one compact card so the IR-level a11y baseline picks up coverage of the four windows-port renderer additions.",
      "wrap": true,
      "isSubtle": true
    },
    {
      "type": "DonutChart",
      "id": "salesChart",
      "title": "Sales by Region",
      "showLegend": true,
      "data": [
        { "label": "Americas", "value": 50 },
        { "label": "EMEA", "value": 30 },
        { "label": "APAC", "value": 20 }
      ]
    },
    {
      "type": "TabSet",
      "id": "detailsTabs",
      "selectedTabId": "trend",
      "tabs": [
        {
          "id": "trend",
          "title": "Trend",
          "items": [
            {
              "type": "BarChart",
              "id": "weeklyBar",
              "title": "Weekly Visits",
              "showLegend": false,
              "data": [
                { "label": "Mon", "value": 12 },
                { "label": "Tue", "value": 18 },
                { "label": "Wed", "value": 24 },
                { "label": "Thu", "value": 21 },
                { "label": "Fri", "value": 30 }
              ]
            }
          ]
        },
        {
          "id": "actions",
          "title": "Actions",
          "items": [
            {
              "type": "CompoundButton",
              "id": "reportBtn",
              "title": "Generate Report",
              "subtitle": "PDF, last 30 days",
              "icon": "doc.fill",
              "action": {
                "type": "Action.Submit",
                "title": "Generate",
                "data": { "report": "monthly" }
              }
            }
          ]
        }
      ]
    },
    {
      "type": "CompoundButton",
      "id": "openDashBtn",
      "title": "Open Dashboard",
      "subtitle": "Full analytics view",
      "icon": "chart.bar.fill",
      "action": {
        "type": "Action.OpenUrl",
        "title": "Open",
        "url": "https://example.com/dashboard"
      }
    },
    {
      "type": "Carousel",
      "id": "highlightCarousel",
      "initialPage": 1,
      "timer": 4000,
      "pages": [
        {
          "items": [
            {
              "type": "TextBlock",
              "text": "Highlight 1: Onboarding",
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "Three-step setup, no install required.",
              "wrap": true
            }
          ]
        },
        {
          "items": [
            {
              "type": "TextBlock",
              "text": "Highlight 2: Reports",
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "Auto-generated PDF reports delivered weekly.",
              "wrap": true
            }
          ]
        },
        {
          "items": [
            {
              "type": "TextBlock",
              "text": "Highlight 3: Integrations",
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "Connect any data source via Power Platform.",
              "wrap": true
            }
          ]
        }
      ]
    }
  ]
}
